# ============================================
# .htaccess untuk shared hosting
# Deploy: upload semua file ke public_html/
# ============================================

# Aktifkan mod_rewrite
<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Route admin area to admin.php
RewriteRule ^admin/login\.php$ /admin.php?action=login [L,QSA]
RewriteRule ^admin/logout\.php$ /admin.php?action=logout [L,QSA]
RewriteRule ^admin/?$ /admin.php [L,QSA]
RewriteRule ^admin/(.*)$ /admin.php?admin_path=$1 [L,QSA]

# Jangan rewrite static files & directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Jangan rewrite app/ dan api/ directories
RewriteCond %{REQUEST_URI} !^/app/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/database/
# Jangan rewrite asset files
RewriteCond %{REQUEST_URI} !^/app/assets/
RewriteCond %{REQUEST_URI} !^/images/
# Route everything else to index.php
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

# ============================================
# Caching untuk static assets
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresDefault "access plus 2 days"
</IfModule>

# ============================================
# Security Headers
# ============================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection 1; mode=block
    Header always set Referrer-Policy strict-origin-when-cross-origin
</IfModule>

# ============================================
# Block sensitive files
# ============================================
<FilesMatch "\.(env|ini|conf|sql|md|json|sh)$">
    Require all denied
</FilesMatch>

<Files "htaccess">
    Require all denied
</Files>
